RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# Rewrite R2 S3 API URLs (require auth) to public browser URLs
# Dev:  R2 bucket public r2.dev subdomain from Cloudflare dashboard
# Prod: custom domain connected to the same R2 bucket
R2_PUBLIC_BASE_URL=
R2_BUCKET_NAME=

# Set true only if your public host serves files WITHOUT the bucket name in the path
# R2_PUBLIC_STRIP_BUCKET=false
